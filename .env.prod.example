# Copy to .env next to docker-compose.prod.yml and fill in. Generate secrets with e.g.
#   openssl rand -hex 32
# (hex keeps them safe inside the connection URLs built from them).

# Image tag to run (a release tag, not "latest")
CRADLE_VERSION=

# Public hostname, without scheme. The TLS proxy in front must serve https://$CRADLE_HOST
CRADLE_HOST=cradle.example.com

# Where nginx is published for the TLS proxy; 127.0.0.1 when the proxy runs on this host
HTTP_BIND=127.0.0.1
HTTP_PORT=8000

SECRET_KEY=
POSTGRES_PASSWORD=
RABBITMQ_PASSWORD=
MINIO_ROOT_USER=cradle
MINIO_ROOT_PASSWORD=

# First admin account, created only while there are no users
CRADLE_ADMIN_USER=admin
CRADLE_ADMIN_EMAIL=
CRADLE_ADMIN_PASSWORD=

SENTRY_DSN=

EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=
EMAIL_USE_TLS=true

# Gunicorn workers and Celery concurrency
NUM_WORKERS=12
CELERY_CONCURRENCY=4
