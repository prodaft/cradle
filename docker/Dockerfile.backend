# vi: ft=dockerfile

FROM python:3.13-slim

WORKDIR /app

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        gdal-bin \
        libgdal-dev \
        gcc \
        python3-dev \
        libmagic-dev && \
    apt-get clean && rm -rf /var/lib/apt/lists/*

RUN pip install uv

COPY ./backend/pyproject.toml .
COPY ./backend/uv.lock .

RUN uv sync --frozen

COPY ./backend/ .

COPY ./backend/cradle/settings_docker.py ./cradle/settings.py

COPY ./docker/entrypoint_backend.sh .
COPY ./docker/entrypoint_celery.sh .

RUN chmod +x ./entrypoint_backend.sh ./entrypoint_celery.sh

CMD ["./entrypoint_backend.sh"]
