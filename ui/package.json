    "optionalDependencies": {
        "@esbuild/linux-x64": "0.24.0",
        "@rollup/rollup-linux-x64-gnu": "4.9.5"
    },
    "scripts": {
        "dev": "electron-vite dev -w",
        "build": "electron-vite build",
        "dev-web": "vite",
        "build-web": "vite build",
        "prettier": "prettier . --write",
        "typecheck": "tsc --noEmit",
        "lint": "eslint src/**/*.ts",
        "verify": "npm run typecheck && npm run lint",
        "generate-api": "rm -rf src/renderer/src/services/cradle/; openapi-generator-cli generate -g typescript-fetch --input-spec ${npm_config_input:-http://localhost:8000/schema/} -c openapitools.json -o src/renderer/src/services/cradle/ && node scripts/fix-openapi-imports.ts"
    },
    "overrides": {
        "@react-three/fiber": "8.15.19"
    },
