        "@tailwindcss/forms": "^0.5.7",
        "@uidotdev/usehooks": "^2.4.1",
        "@uiw/codemirror-extensions-events": "^4.25.2",
        "@uiw/codemirror-theme-eclipse": "^4.25.2",
        "@uiw/codemirror-theme-vscode": "^4.25.2",
