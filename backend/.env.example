# Django (secrets, hosts, URLs)
ADMIN_PATH_UUID=1eef2e9b-6350-4fb7-a65b-ccaaf09c39b2
ALLOWED_HOSTS=localhost
CSRF_TRUSTED_ORIGINS=http://localhost
DEBUG=False
FRONTEND_URL=http://localhost:5173
# Reverse proxies in front of the backend that append to X-Forwarded-For (0 when it is reached directly)
# TRUSTED_PROXY_COUNT=1
# Required. Generate one: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY="your-generated-secret-key-here"

# PostgreSQL (Docker Compose postgres service)
POSTGRES_DB=cradle
POSTGRES_PASSWORD=cradle
POSTGRES_USER=cradle

# PostgreSQL (Django DATABASES)
DB_NAME=cradle
DB_PASSWORD=cradle
DB_USER=cradle
# DB_HOST=localhost
# DB_PORT=5432

# Object storage (MinIO / S3)
MINIO_ENDPOINT=localhost:9000
MINIO_ROOT_PASSWORD=cradle_minio
MINIO_ROOT_USER=admin
MINIO_SECURE=False
# MINIO_BACKEND_URL=http://localhost:9000

# Celery (RABBITMQ_URL or REDIS_URL; result backend uses Redis)
RABBITMQ_URL=amqp://cradle:cradle@localhost:5672//
REDIS_URL=redis://localhost:6379/0

# JWT
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=30
JWT_COOKIE_DOMAIN=
JWT_COOKIE_PATH=/
JWT_COOKIE_SECURE=False
JWT_REFRESH_TOKEN_LIFETIME_DAYS=14

# Email (SMTP)
DEFAULT_FROM_EMAIL=""
EMAIL_HOST=""
EMAIL_HOST_PASSWORD=""
EMAIL_HOST_USER=""
EMAIL_PORT=587
EMAIL_USE_TLS=False

# Bootstrap admin (manage.py initadmin)
CRADLE_ADMIN_EMAIL=admin@cradle.sh
CRADLE_ADMIN_PASSWORD=admin
CRADLE_ADMIN_USER=admin

# Intelio enricher containers (optional overrides)
# ENRICHER_DOCKER_IMAGE_PREFIX=cradle/enricher
# ENRICHER_MEM_LIMIT=256m
# ENRICHER_CPU_QUOTA=50000
# ENRICHER_TIMEOUT=120
# ENRICHER_EXTERNAL_NETWORK=enricher_external

# Report branding for HTML and PDF reports (paths must be readable by the backend)
# REPORT_BRANDING_ORGANIZATION=CRADLE
# REPORT_BRANDING_TAGLINE=
# REPORT_BRANDING_CONTACT=
# REPORT_BRANDING_LOGO=/srv/branding/logo.png
# REPORT_BRANDING_COVER_IMAGE=/srv/branding/cover.jpg
# REPORT_BRANDING_WATERMARK=/srv/branding/watermark.png
# REPORT_BRANDING_DISCLAIMER=
# REPORT_BRANDING_STYLESHEET=/srv/branding/report.css
# REPORT_BRANDING_PAGE_MARGIN=25mm
# REPORT_BRANDING_FONT_SIZE=11pt
# REPORT_BRANDING_HEADER_FONT_SIZE=11pt
# Colors default to the accent color; set a hex value to override.
# REPORT_BRANDING_PAGE_NUMBER_COLOR=#3d536e
# REPORT_BRANDING_TOC_COLOR=#3d536e
# REPORT_BRANDING_PARAGRAPH_INDENT=6mm
# Fonts named <Family>-<Style>.otf, e.g. Brand-Light.otf.
# REPORT_BRANDING_FONT_DIR=/srv/branding/fonts
# REPORT_BRANDING_FONT_FAMILY=Brand
# REPORT_BRANDING_FONT_WEIGHT=400
# REPORT_BRANDING_BOLD_WEIGHT=700

# Optional (defaults in code; alphabetical)
# AWS_S3_ENDPOINT_URL=
# AWS_S3_REGION_NAME=us-east-1
# AWS_S3_SIGNATURE_VERSION=s3v4
# AWS_S3_VERIFY=True
# CORS_ALLOWED_ORIGINS=
# CRADLE_AUTO_CREATE_BUCKETS=1
# DB_ENGINE=django.contrib.gis.db.backends.postgis
# DIGEST_TRUSTED_FILE_HOSTS=
# NOCHECK_EMAIL_SSL=False
# OAUTH_REDIRECT_URI_WHITELIST=
# SENTRY_DSN=
# STATIC_URL=static/
# USE_SILK=False
