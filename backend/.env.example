#!/bin/sh

# PostgreSQL (for Docker Compose - postgres container)
POSTGRES_DB=cradle
POSTGRES_PASSWORD=cradle
POSTGRES_USER=cradle

# Django DB connection (cradle.settings reads these)
DB_NAME=cradle
DB_PASSWORD=cradle
DB_USER=cradle
# DB_HOST=localhost
# DB_PORT=5432

# MinIO / S3 storage
MINIO_ENDPOINT=localhost:9000
MINIO_ROOT_PASSWORD=cradle_minio
MINIO_ROOT_USER=admin
MINIO_SECURE=False
# MINIO_BACKEND_URL=http://localhost:9000

# Task queue: RABBITMQ_URL or REDIS_URL (or both)
RABBITMQ_URL=amqp://cradle:cradle@localhost:5672//
REDIS_URL=redis://localhost:6379/0

# Cradle core
ALLOWED_HOSTS=localhost
BASE_URL=api
CSRF_TRUSTED_ORIGINS=http://localhost
DEBUG=False
FRONTEND_URL=http://localhost:5173
SECRET_KEY="your-generated-secret-key-here"

# Admin user (initadmin command)
CRADLE_ADMIN_EMAIL=admin@cradle.sh
CRADLE_ADMIN_PASSWORD=admin
CRADLE_ADMIN_USER=admin

# JWT
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=30
JWT_COOKIE_DOMAIN=
JWT_COOKIE_PATH=/
JWT_COOKIE_SECURE=False
JWT_REFRESH_TOKEN_LIFETIME_DAYS=14

# Email
DEFAULT_FROM_EMAIL=""
EMAIL_HOST=""
EMAIL_HOST_PASSWORD=""
EMAIL_HOST_USER=""
EMAIL_PORT=587
EMAIL_USE_TLS=False

# Enricher container isolation (tunable, isolation is always on)
# ENRICHER_DOCKER_IMAGE_PREFIX=cradle/enricher
# ENRICHER_MEM_LIMIT=256m
# ENRICHER_CPU_QUOTA=50000
# ENRICHER_TIMEOUT=120
# ENRICHER_EXTERNAL_NETWORK=enricher_external

# Optional (have defaults or rarely overridden)
# ALLOW_REGISTRATION=True
# AUTOREGISTER_ARTIFACT_TYPES=True
# AWS_S3_VERIFY=True
# CORS_ALLOWED_ORIGINS=
# CRADLE_AUTO_CREATE_BUCKETS=1
# DB_ENGINE=django.contrib.gis.db.backends.postgis
# MIN_ENTITY_COUNT_PER_NODE=1
# MIN_ENTRY_COUNT_PER_NODE=2
# NOCHECK_EMAIL_SSL=False
# OAUTH_REDIRECT_URI_WHITELIST=
# SENTRY_DSN=
# STATIC_URL=static/
# USE_SILK=False
