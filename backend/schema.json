components:
  schemas:
    APIKeyResponse:
      type: object
      description: Serializer for API key generation response.
      properties:
        api_key:
          type: string
          description: Generated API key
      required:
      - api_key
    AccessEntity:
      type: object
      properties:
        id:
          type: integer
        name:
          type: string
          maxLength: 200
        access_type:
          type: string
          default: none
          maxLength: 200
      required:
      - id
      - name
    AccessRequest:
      type: object
      properties:
        access_type:
          enum:
          - none
          - read
          - read-write
          type: string
          description: |-
            * `none` - none
            * `read` - read
            * `read-write` - read-write
          x-spec-enum-id: 8bc10dbec337670e
      required:
      - access_type
    AccessRequestNotification:
      type: object
      properties:
        id:
          type: string
          format: uuid
          readOnly: true
        message:
          type: string
        is_marked_unread:
          type: boolean
        entity_id:
          type: integer
          readOnly: true
        requesting_user_id:
          type: string
          format: uuid
          readOnly: true
        timestamp:
          type: string
          format: date-time
          readOnly: true
        notification_type:
          type: string
          readOnly: true
      required:
      - message
    AccessUser:
      type: object
      properties:
        user:
          $ref: '#/components/schemas/UserRetrieve'
        access_type:
          enum:
          - none
          - read
          - read-write
          type: string
          description: |-
            * `none` - none
            * `read` - read
            * `read-write` - read-write
          x-spec-enum-id: 8bc10dbec337670e
      required:
      - access_type
      - user
    Attachment:
      type: object
      description: Serializer for Attachment model with presigned download URL.
      properties:
        id:
          type: string
          format: uuid
          readOnly: true
        name:
          type: string
          maxLength: 255
        type:
          type: string
          maxLength: 255
        context: {}
        presigned_url:
          type: string
          nullable: true
          readOnly: true
      required:
      - name
      - type
    BaseDigest:
      type: object
      properties:
        id:
          type: string
          format: uuid
          readOnly: true
        title:
          type: string
          maxLength: 255
        user_detail:
