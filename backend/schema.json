  /notes/files/:
    get:
      operationId: notes_files_retrieve
      description: Returns paginated list of files that are linked to notes the user
        has access to. Can filter by references and other parameters. Results are
        ordered by note timestamp descending.
      summary: Get files from accessible notes
      parameters:
      - in: query
        name: any_field
        schema:
          type: string
        description: Filter with an or over all fields (case-insensitive partial match)
      - in: query
        name: date
        schema:
          type: string
        description: Filter notes by date (YYYY-MM-DD format)
      - in: query
        name: keyword
        schema:
          type: string
        description: Filter files by keyword in filename or exact match in hash
      - in: query
        name: linked_to
        schema:
          type: string
        description: Filter notes by being linked to a specific entry
      - in: query
        name: mimetype
        schema:
          type: string
        description: Filter files by mimetype (case-insensitive partial match)
      - in: query
        name: order_by
        schema:
          type: string
          default: -timestamp
        description: 'Order files by field(s). Prefix with ''-'' for descending order.
          Multiple fields can be separated by commas. Valid fields: timestamp, file_name,
          mimetype. Default: -timestamp'
      - in: query
        name: page
        schema:
          type: integer
        description: Page number for pagination
      - in: query
        name: page_size
        schema:
          type: integer
          default: 10
        description: Number of files to return per page. Max 200.
      - in: query
        name: references
        schema:
          type: array
          items:
            type: string
        description: Filter notes by referenced entry IDs
      - in: query
        name: status
        schema:
          type: string
        description: 'Filter files by status: ''healthy'' (has sha256 hash) or ''warning''
          (missing sha256 hash)'
      - in: query
        name: timestamp_gte
        schema:
          type: string
        description: Filter notes by timestamp greater than or equal to (ISO datetime
          format)
      - in: query
        name: timestamp_lte
        schema:
          type: string
        description: Filter notes by timestamp less than or equal to (ISO datetime
          format)
      tags:
      - notes
      security:
      - jwtAuth: []
      responses:
        '200':
