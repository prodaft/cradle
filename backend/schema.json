  /management/settings/:
    get:
      operationId: management_settings_retrieve
      description: Returns all known settings in a nested JSON format, including defaults
        for any missing values.
      summary: Get all settings with defaults
      tags:
      - management
      security:
      - ApiKey: []
      - jwtAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                type: object
                additionalProperties: {}
          description: Nested settings dictionary with defaults applied.
    post:
      operationId: management_settings_create
      description: Accepts a nested JSON object to create or update multiple settings
        at once. Each key becomes a namespaced setting key like `notes.max_note_wordcount`.
      summary: Update one or more settings
      tags:
      - management
      requestBody:
        content:
          application/json:
            schema:
              type: object
              additionalProperties: {}
            examples:
              ExamplePOST:
                value:
                  notes:
                    max_note_wordcount: 2000
                    allow_file_uploads: true
                  ui:
                    theme: dark
                summary: Example POST
      security:
      - ApiKey: []
      - jwtAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                type: object
                additionalProperties: {}
          description: Successfully updated all settings.
        '207':
          content:
            application/json:
              schema:
                type: object
                additionalProperties: {}
          description: Some settings updated, others failed.
  /notes/:
    get:
      operationId: notes_list
      description: Returns paginated list of notes that the user has access to. Can
        filter by references and other parameters. Results are ordered by timestamp
        descending.
      summary: Get accessible notes
      parameters:
      - in: query
        name: any_field
        schema:
          type: string
        description: Filter with an or over all fields (case-insensitive partial match)
      - in: query
        name: author__username
        schema:
          type: string
        description: Filter by author username (case-insensitive partial match)
      - in: query
        name: content
        schema:
          type: string
        description: Filter by note content (case-insensitive partial match)
      - in: query
        name: date
        schema:
          type: string
        description: Filter by note date (YYYY-MM-DD format)
      - in: query
        name: linked_to
        schema:
          type: string
        description: Filter notes by being linked to a specific entry
      - in: query
        name: order_by
        schema:
          type: string
          default: -timestamp
        description: 'Order notes by field(s). Prefix with ''-'' for descending order.
          Multiple fields can be separated by commas. Valid fields: timestamp, edit_timestamp,
          title, author__username. Default: -timestamp'
      - in: query
        name: page
        schema:
          type: integer
        description: Page number for pagination
      - in: query
        name: page_size
        schema:
          type: integer
          default: 10
        description: Number of notes to return per page. Max 200.
      - in: query
        name: references
        schema:
          type: array
          items:
            type: string
        description: Filter notes by referenced entry IDs
      - in: query
        name: status
        schema:
          type: string
          enum:
          - finalized
          - fleeting
          - healthy
          - invalid
          - processing
          - warning
        description: Filter by note status, finalized covers all statuses except for
          fleeting
      - in: query
        name: timestamp_gte
        schema:
          type: string
        description: Filter by timestamp greater than or equal to (ISO datetime format)
      - in: query
        name: timestamp_lte
        schema:
          type: string
        description: Filter by timestamp less than or equal to (ISO datetime format)
      - in: query
        name: truncate
        schema:
          type: integer
          default: 200
        description: Number of characters to truncate note content to
      tags:
      - notes
      security:
      - jwtAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/PaginatedNoteRetrieveSerializerResponse'
          description: ''
        '400':
          content:
            application/json:
              schema:
                type: object
                properties:
                  type:
                    type: string
                    description: URI reference identifying the problem type
                    example: /errors/validation-error
                  title:
                    type: string
                    description: Short, human-readable summary of the problem type
                    example: Validation Error
                  status:
                    type: integer
                    description: HTTP status code
                    example: 400
                  detail:
                    type: string
                    description: Human-readable explanation specific to this occurrence
                    example: One or more fields failed validation.
                  instance:
                    type: string
                    description: URI reference identifying the specific occurrence
                    example: /api/users/create
                  timestamp:
                    type: string
                    format: date-time
                    description: ISO 8601 timestamp when the error occurred
                    example: '2025-11-08T14:32:10.123456Z'
                  code:
                    type: string
                    description: Machine-readable error code
                    example: VALIDATION_ERROR
                  errors:
                    type: object
                    description: Field-level validation errors (only present for validation
                      errors)
                    additionalProperties:
                      type: array
