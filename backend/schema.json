        title:
          type: string
          minLength: 1
          maxLength: 255
        digest_type:
          type: string
          minLength: 1
          maxLength: 255
        entities:
          type: array
          items:
            type: integer
          description: Optional entities to associate with this digest
      required:
      - digest_type
      - title
    DigestUploadResponse:
      type: object
