  /query/:
    get:
      operationId: query_list
      description: Allow a user to query entries they have access to by providing
        filters.
      summary: Query Entries
      parameters:
      - in: query
        name: name
        schema:
          type: array
          items:
            type: string
        description: Filter by entry name (case-insensitive contains search)
      - in: query
        name: name_exact
        schema:
          type: array
          items:
            type: string
        description: Filter by exact entry name
      - in: query
        name: page
        schema:
          type: integer
        description: Pagination page number
      - in: query
        name: page_size
