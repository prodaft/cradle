paths:
  /access/entity/{entity_id}/:
    get:
      operationId: access_entity_list
      description: Returns a list of all users with their access types for a specific
        entity. Only available to admin users.
      summary: Get entity access privileges
      parameters:
      - in: path
        name: entity_id
        schema:
          type: integer
        description: Id of the entity to get access privileges for
        required: true
      - in: query
        name: search
        schema:
          type: string
        description: Search users by username or user ID
      tags:
      - access
      security:
      - jwtAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                type: array
                items:
                  $ref: '#/components/schemas/AccessUser'
          description: ''
        '404':
          content:
            application/json:
              schema:
                type: object
                properties:
                  type:
                    type: string
                    description: URI reference identifying the problem type
                    example: /errors/validation-error
                  title:
                    type: string
                    description: Short, human-readable summary of the problem type
                    example: Validation Error
                  status:
                    type: integer
                    description: HTTP status code
                    example: 400
                  detail:
                    type: string
                    description: Human-readable explanation specific to this occurrence
                    example: One or more fields failed validation.
                  instance:
                    type: string
                    description: URI reference identifying the specific occurrence
                    example: /api/users/create
                  timestamp:
                    type: string
                    format: date-time
                    description: ISO 8601 timestamp when the error occurred
                    example: '2025-11-08T14:32:10.123456Z'
                  code:
                    type: string
                    description: Machine-readable error code
                    example: VALIDATION_ERROR
                  errors:
                    type: object
                    description: Field-level validation errors (only present for validation
                      errors)
                    additionalProperties:
                      type: array
                      items:
                        type: string
                    example:
                      username:
                      - This field is required.
                      email:
                      - Enter a valid email address.
                required:
                - type
                - title
                - status
                - detail
                - timestamp
                - code
              examples:
                ENTITYNOTFOUND:
