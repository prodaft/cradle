  /access/user/{user_id}/{entity_id}/:
    put:
      operationId: access_user_update
      description: Updates a user's access privileges for a specific entity. Admin
        users can update access for non-admin users. Users with read-write access
        can update access for non-admin users who don't have read-write access.
      summary: Update user access for entity
      parameters:
      - in: path
        name: entity_id
        schema:
          type: integer
        description: Id of the entity to update access for
        required: true
      - in: path
        name: user_id
        schema:
          type: string
        description: UUID of the user whose access is being updated
        required: true
      tags:
      - access
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/AccessRequest'
        required: true
      security:
      - jwtAuth: []
