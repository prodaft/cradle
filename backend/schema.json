          readOnly: true
        created_at:
          type: string
          format: date-time
          readOnly: true
        status:
          enum:
          - working
          - warning
          - done
          - error
          type: string
          description: |-
            * `working` - Working
            * `warning` - Warning
            * `done` - Done
            * `error` - Error
          x-spec-enum-id: 642f4d2c078faf74
        errors: {}
        warnings: {}
        digest_type:
          type: string
          maxLength: 255
        display_name:
          type: string
          readOnly: true
        entity_detail:
          allOf:
          - $ref: '#/components/schemas/Entry'
          readOnly: true
      required:
      - digest_type
      - title
    BaseDigestCreateRequest:
      type: object
      description: Serializer for creating digests with file upload.
      properties:
        title:
          type: string
          minLength: 1
          maxLength: 255
        digest_type:
          type: string
          minLength: 1
          maxLength: 255
        entities:
          type: array
          items:
            type: integer
          description: Optional entities to associate with this digest
        file:
          type: string
          format: binary
          writeOnly: true
          description: The file to be processed by the digest
      required:
      - digest_type
      - file
      - title
    ChangePasswordRequestRequest:
      type: object
      description: Serializer for change password request.
      properties:
        old_password:
          type: string
          minLength: 1
          description: Current password of the user
        new_password:
          type: string
          minLength: 1
          description: New password to set
      required:
      - new_password
      - old_password
    ChangePasswordResponse:
      type: object
      description: Serializer for change password response.
      properties:
        detail:
          type: string
          default: Password changed successfully.
          description: Success message
    DefaultNoteTemplateRequest:
      type: object
      description: Serializer for default note template.
      properties:
        template:
          type: string
          description: Default template text for new notes
      required:
      - template
    DefaultNoteTemplateResponse:
      type: object
      description: Serializer for default note template response.
      properties:
        template:
          type: string
          nullable: true
          description: Current default template for new notes
      required:
      - template
    DigestSubclass:
      type: object
