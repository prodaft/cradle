  /knowledge-graph/:
    get:
      operationId: knowledge_graph_retrieve
      description: Returns the full knowledge graph accessible to the user.
      summary: Get knowledge graph
      tags:
      - knowledge-graph
      security:
      - jwtAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/PaginatedSubGraphSerializerResponse'
          description: ''
        '401':
          content:
            application/json:
              schema:
                description: User is not authenticated
          description: ''
  /knowledge-graph/inaccessible/:
    get:
      operationId: knowledge_graph_inaccessible_retrieve
      description: Get entries in the knowledge graph that are inaccessible to the
        current user.
      summary: Get inaccessible graph entries
      parameters:
      - in: query
        name: depth
        schema:
          type: integer
          default: 0
        description: Search depth (0-5)
      - in: query
        name: src
        schema:
          type: string
        description: Source entry ID
        required: true
      tags:
      - knowledge-graph
      security:
      - jwtAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/GraphInaccessibleResponse'
          description: ''
        '400':
          content:
            application/json:
              schema:
                description: Invalid parameters
          description: ''
        '401':
          content:
            application/json:
              schema:
                description: User is not authenticated
          description: ''
        '404':
          content:
            application/json:
              schema:
                description: Source entry not found
          description: ''
  /knowledge-graph/neighbors/:
    get:
      operationId: knowledge_graph_neighbors_retrieve
      description: Get neighboring entries in the knowledge graph for a given source
        entry.
      summary: Get graph neighbors
      parameters:
      - in: query
        name: depth
        schema:
          type: integer
          default: 1
        description: Search depth (0-5)
      - in: query
        name: name
        schema:
          type: array
          items:
            type: string
        description: Filter by entry name (case-insensitive contains). Supports repeated
          params.
        explode: true
      - in: query
        name: page
        schema:
          type: integer
          default: 1
        description: Page number
      - in: query
        name: page_size
        schema:
          type: integer
          default: 200
        description: Number of results per page
      - in: query
        name: query
        schema:
          type: string
        description: Query filter for results
      - in: query
        name: src
        schema:
          type: string
        description: Source entry ID
        required: true
      - in: query
        name: subtype
        schema:
          type: array
          items:
            type: string
        description: 'Filter by entry subtype(s). Supports repeated params: ?subtype=a&subtype=b'
        explode: true
      - in: query
        name: wildcard
        schema:
          type: boolean
          default: false
        description: Use wildcard matching for query
      tags:
      - knowledge-graph
      security:
      - jwtAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/LazyPaginatedEntryWithDepthSerializerViewResponse'
          description: ''
        '400':
          content:
            application/json:
              schema:
                description: Invalid parameters or query syntax
          description: ''
        '401':
          content:
            application/json:
              schema:
                description: User is not authenticated
          description: ''
        '404':
          content:
            application/json:
              schema:
                description: Source entry not found
          description: ''
  /knowledge-graph/paths/:
    get:
      operationId: knowledge_graph_paths_retrieve
      description: Find paths between source and destination entries in the knowledge
        graph.
      summary: Find paths in knowledge graph
      parameters:
      - in: query
        name: dsts
        schema:
          type: array
          items:
            type: integer
        description: Destination entry IDs
        required: true
      - in: query
        name: max_date
        schema:
          type: string
        description: Maximum date
      - in: query
        name: min_date
        schema:
          type: string
        description: Minimum date
      - in: query
        name: src
        schema:
          type: string
        description: Source entry ID
        required: true
      tags:
      - knowledge-graph
      security:
      - jwtAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/SubGraph'
          description: ''
        '400':
          content:
            application/json:
              schema:
                description: Invalid request data
          description: ''
        '401':
          content:
            application/json:
              schema:
                description: User is not authenticated
          description: ''
  /logs/:
    get:
      operationId: logs_list
